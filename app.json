{
  "expo": {
    "name": "MoCoSS",
    "slug": "MoCoSS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mocoss.png",
    "scheme": "mocossv2",
    "userInterfaceStyle": "automatic",
   "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/mocoss-adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.MoCoSS"
    },
    "ios": {
      "icon": "./assets/images/mocoss-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.MoCoSS",
      "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mocoss.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MoCoSS to access phonecamera for counseling video sessions.",
          "microphonePermission": "Allow MoCoSS to access phone microphone for counseling session audio.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
